# Gemini API dùng để trích xuất địa điểm và tìm trang ảnh bổ sung.
# Điền khóa Gemini đầu tiên; không gửi key qua chat.
GEMINI_API_KEY=
# Khóa dự phòng nên thuộc project Gemini khác; quota tính theo project.
# Có thể khai báo GEMINI_API_KEY_2, GEMINI_API_KEY_3, ... hoặc
# liệt kê thêm khóa cách nhau bằng dấu phẩy trong GEMINI_API_KEYS.
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_API_KEY_7=
GEMINI_API_KEY_8=
GEMINI_API_KEY_9=
GEMINI_API_KEY_10=
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_CRAWL_MODEL=gemini-3.8-flash
GEMINI_SEARCH_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Số lượt tìm web ảnh tối đa mỗi ngày (0 để tắt, áp dụng qua các batch 5 phút).
GEMINI_IMAGE_SEARCH_LIMIT=20
DATA_BACKEND=postgres
MONGODB_URI=
MONGODB_DATABASE=travel_path
DB_NAME=tourism_db
DB_USER=tourism_user
DB_PASSWORD=change-this-before-deploy
# Optional bootstrap admin account. Use a real email and a password of 12+ characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
AUTH_COOKIE_SECURE=false
AUTH_SESSION_DAYS=7
# Email OTP registration. Configure an SMTP sender before users can register.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
AUTH_OTP_SECRET=
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=8080
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=5432
BACKEND_BIND=127.0.0.1
BACKEND_PORT=8001
OLLAMA_BIND=127.0.0.1
OLLAMA_PORT=11434

# Chạy Ollama cục bộ sau khi mọi khóa Gemini đã hết quota.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_FALLBACK_MODEL=qwen3.5:4b
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_NUM_CTX=16384

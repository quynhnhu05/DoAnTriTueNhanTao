# Copy to .env.web on the deployment machine and replace the example password.
DB_NAME=tourism_db
DB_USER=tourism_user
DB_PASSWORD=replace-with-a-long-random-password

# Public web port for an IP-based preview/deployment.
FRONTEND_BIND=0.0.0.0
FRONTEND_PORT=8080

# Keep internal services reachable only from the server itself.
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=5432
BACKEND_BIND=127.0.0.1
BACKEND_PORT=8001
OLLAMA_BIND=127.0.0.1
OLLAMA_PORT=11434

DATA_BACKEND=postgres
MONGODB_URI=
MONGODB_DATABASE=travel_path
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_API_KEY_7=
GEMINI_API_KEY_8=
GEMINI_API_KEY_9=
GEMINI_API_KEY_10=
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_CRAWL_MODEL=gemini-3.8-flash
GEMINI_SEARCH_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_IMAGE_SEARCH_LIMIT=20
OSRM_URL=https://router.project-osrm.org
